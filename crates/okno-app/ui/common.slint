// Types shared by the widget kits and the screens.

export struct NavItem {
    title: string,
    icon: image,
}

export struct HeaderAction {
    icon: image,
    tooltip: string,
}

export enum ResizeEdge { north, south, east, west, north-east, north-west, south-east, south-west }

// Window management for client-side decorations. Globals are per window, so
// each window wires its own handlers from Rust.
export global WindowOps {
    in property <bool> maximized;
    in property <bool> active: true;
    // Buttons left and right of the title, from GNOME's button-layout,
    // each one of "minimize", "maximize", "close".
    in property <[string]> start-buttons: [];
    in property <[string]> end-buttons: ["minimize", "maximize", "close"];
    callback drag();
    callback toggle-maximize();
    callback minimize();
    callback close();
    callback resize(ResizeEdge);
    callback show-menu();
}

export global Icons {
