// Okno screens. They only use the widget kit imported from "@kit", which
// build.rs maps to kit/adwaita (Linux) or kit/fluent (Windows).

import { ComboBox } from "std-widgets.slint";
import {
    Theme, KText, KIcon, KButton, KIconButton, KEntry, KSwitch, KGroup, KRow, KEntryRow, KSwitchRow,
    KButtonRow, KStatusPage, KPage, KSplitView, KHeaderBar, KAppWindow, KSheet, KDialog, KDialogButtons,
    KToast, KSpinner, KCaption, KProgressBar,
} from "@kit/kit.slint";
import { NavItem, HeaderAction, Icons, WindowOps } from "common.slint";

export { Theme, WindowOps }

export struct DeviceRow {
    name: string,
    subtitle: string,
    endpoint: string,
    fingerprint: string,
    known: bool,
}

export struct SessionRow {
    id: int,
    title: string,
    subtitle: string,
}

export struct FileRow {
    name: string,
    subtitle: string,
    is-dir: bool,
}

export struct TransferRow {
    name: string,
    status: string,
    progress: float,
    // 0 running, 1 done, 2 failed
    state: int,
    upload: bool,
}

export struct TermRun {
    row: int,
    col: int,
    len: int,
    text: string,
    fg: color,
    default-fg: bool,
    bg: color,
    has-bg: bool,
    bold: bool,
    italic: bool,
    underline: bool,
}

export struct ForwardRow {
    title: string,
    subtitle: string,
}

export enum DialogKind { none, connecting, trust-new, trust-changed, login }

component DevicesPage inherits KPage {
    in property <[DeviceRow]> nearby;
    in property <[DeviceRow]> recent;
    in property <bool> searching;
    in-out property <string> address;
    callback connect(string);
    callback forget(string);

    KGroup {
        title: @tr("Connect by Address");
        description: @tr("A name or IP address on this network, optionally with a port.");
        KEntryRow {
            title: @tr("Computer Address");
            text <=> root.address;
            first: true;
            last: true;
            show-apply: root.address != "";
            accepted => { if root.address != "" { root.connect(root.address); } }
            applied => { root.connect(root.address); }
        }
    }

    if nearby.length > 0: KGroup {
        title: @tr("On This Network");
        busy: root.searching;
        for d[i] in nearby: KRow {
            has-icon: true;
            icon: Icons.devices;
            title: d.name;
            subtitle: d.subtitle;
            activatable: true;
            last: i == nearby.length - 1;
            clicked => { root.connect(d.endpoint); }
            if d.known: KIcon { source: Icons.ok; tint: Theme.success; }
            KIcon { source: Icons.go; tint: Theme.dim-fg; }
        }
    }
    if nearby.length == 0: KStatusPage {
        compact: true;
        icon: Icons.network;
        title: root.searching ? @tr("Searching…") : @tr("No Devices Found");
        description: root.searching ? "" : @tr("Computers appear here when Okno runs on them with remote control allowed.");
    }

    if recent.length > 0: KGroup {
        title: @tr("Trusted Devices");
        description: @tr("Devices whose key you have accepted.");
        for d[i] in recent: KRow {
            has-icon: true;
            icon: Icons.key;
            title: d.name;
            subtitle: d.subtitle;
            activatable: true;
            last: i == recent.length - 1;
            clicked => { root.connect(d.endpoint); }
            KIconButton {
                icon: Icons.trash;
                tooltip: @tr("Forget");
                clicked => { root.forget(d.fingerprint); }
            }
        }
    }
}

component HostPage inherits KPage {
    in property <bool> running;
    in property <bool> starting;
    in property <string> status;
    in property <string> fingerprint;
    in property <string> addresses;
    in property <bool> has-login;
    in property <string> login-user;
    in property <string> login-error;
    in property <[SessionRow]> sessions;
    in-out property <bool> discoverable;
    in-out property <string> new-user;
    in-out property <string> new-password;
    in-out property <string> new-repeat;
    callback toggle(bool);
    callback set-login;
    callback disconnect(int);
    callback discoverable-changed(bool);

    KGroup {
        busy: root.starting;
        KSwitchRow {
            has-icon: true;
            icon: Icons.host;
            title: @tr("Allow Remote Control");
            subtitle: root.status;
            checked: root.running;
            enabled: root.has-login && !root.starting;
            toggled(on) => { root.toggle(on); }
        }
        KSwitchRow {
            has-icon: true;
            icon: Icons.network;
            title: @tr("Visible on the Network");
            subtitle: @tr("Others find this computer without typing its address.");
            checked <=> root.discoverable;
            last: true;
            toggled(on) => { root.discoverable-changed(on); }
        }
    }

    if sessions.length > 0: KGroup {
        title: @tr("Connected Now");
        for s[i] in sessions: KRow {
            has-icon: true;
            icon: Icons.link;
            title: s.title;
            subtitle: s.subtitle;
            last: i == sessions.length - 1;
            KButton {
                text: @tr("Disconnect");
                destructive: true;
                clicked => { root.disconnect(s.id); }
            }
        }
    }

    KGroup {
        title: @tr("Identity");
        description: @tr("People connecting to you see this fingerprint the first time. Compare it before they trust it.");
        KRow {
            title: @tr("Fingerprint");
            subtitle: root.fingerprint;
            mono-subtitle: true;
        }
        KRow {
            title: @tr("Addresses");
            subtitle: root.addresses == "" ? @tr("Not accepting connections") : root.addresses;
            last: true;
        }
    }

    VerticalLayout {
        spacing: 12px;
        KGroup {
            title: @tr("Login");
            description: root.has-login
                ? @tr("People connecting to this computer log in as “{}”.", root.login-user)
                : @tr("Set a username and password before allowing remote control.");
            KEntryRow {
                title: @tr("Username");
                text <=> root.new-user;
                first: true;
            }
            KEntryRow {
                title: @tr("Password");
                password: true;
                text <=> root.new-password;
                error: root.login-error != "";
            }
            KEntryRow {
                title: @tr("Repeat Password");
                password: true;
                text <=> root.new-repeat;
                error: root.login-error != "";
                last: true;
                accepted => { root.set-login(); }
            }
        }
        HorizontalLayout {
            spacing: 12px;
            if root.login-error != "": KCaption {
                text: root.login-error;
                color: Theme.destructive-text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.login-error == "": Rectangle { horizontal-stretch: 1; }
            KButton {
                text: root.has-login ? @tr("Change Login") : @tr("Save Login");
                primary: true;
                enabled: root.new-password != "";
                clicked => { root.set-login(); }
            }
        }
    }
}

component SettingsContent inherits KPage {
    in-out property <string> device-name;
    in property <string> saved-name;
    in property <string> fingerprint;
    in-out property <string> port;
    in property <string> saved-port;
    in-out property <string> networks;
    in property <string> saved-networks;
    in property <string> incoming;
    in property <string> error;
    callback device-name-committed(string);
    callback port-committed(string);
    callback networks-committed(string);
    callback choose-incoming;

    KGroup {
        title: @tr("This Device");
        KEntryRow {
            title: @tr("Device Name");
            text <=> root.device-name;
            first: true;
            show-apply: root.device-name != root.saved-name && root.device-name != "";
            accepted => { root.device-name-committed(root.device-name); }
            applied => { root.device-name-committed(root.device-name); }
        }
        KRow {
            title: @tr("Device Fingerprint");
            subtitle: root.fingerprint;
            mono-subtitle: true;
            last: true;
        }
    }

    KGroup {
        title: @tr("Incoming Connections");
        description: @tr("Changes restart remote control if it is on.");
        KEntryRow {
            title: @tr("Port");
            text <=> root.port;
            first: true;
            error: root.error != "" && root.port != root.saved-port;
            show-apply: root.port != root.saved-port && root.port != "";
            accepted => { root.port-committed(root.port); }
            applied => { root.port-committed(root.port); }
        }
        KEntryRow {
            title: @tr("Allowed Networks, comma-separated");
            text <=> root.networks;
            error: root.error != "" && root.networks != root.saved-networks;
            show-apply: root.networks != root.saved-networks && root.networks != "";
            accepted => { root.networks-committed(root.networks); }
            applied => { root.networks-committed(root.networks); }
        }
        KRow {
            title: @tr("Received Files");
            subtitle: root.incoming;
            last: true;
            KButton {
                text: @tr("Change…");
                clicked => { root.choose-incoming(); }
            }
        }
    }
    if root.error != "": KCaption {
        text: root.error;
        color: Theme.destructive-text;
    }
}

export component MainWindow inherits KAppWindow {
    title: "Okno";
    icon: @image-url("icons/app.svg");
    preferred-width: 980px;
    preferred-height: 680px;
    min-width: 720px;
    min-height: 480px;

    in-out property <int> page: 0;
    in-out property <bool> settings-open;
    in-out property <bool> about-open;

    // Devices
    in property <[DeviceRow]> nearby;
    in property <[DeviceRow]> recent;
    in property <bool> searching;
    in-out property <string> address;
    callback connect(string);
    callback refresh;
    callback forget(string);

    // Connection dialogs
    in-out property <DialogKind> dialog: DialogKind.none;
    in property <string> dialog-host;
    in property <string> dialog-fingerprint;
    in property <string> dialog-previous;
    in-out property <string> login-user;
    in-out property <string> login-password;
    in property <string> login-error;
    in property <bool> login-busy;
    callback trust-accepted;
    callback dialog-cancelled;
    callback login-submitted;

    // Host
    in property <bool> host-running;
    in property <bool> host-starting;
    in property <string> host-status;
    in property <string> host-fingerprint;
    in property <string> host-addresses;
    in property <bool> host-has-login;
    in property <string> host-login-user;
    in property <string> host-login-error;
    in property <[SessionRow]> host-sessions;
    in-out property <bool> host-discoverable;
    in-out property <string> host-new-user;
    in-out property <string> host-new-password;
    in-out property <string> host-new-repeat;
    callback host-toggle(bool);
    callback host-set-login;
    callback host-disconnect(int);
    callback host-discoverable-changed(bool);

    // Settings
    in-out property <string> device-name;
    in property <string> saved-device-name;
    in property <string> version;
    in-out property <string> host-port;
    in property <string> host-saved-port;
    in-out property <string> host-networks;
    in property <string> host-saved-networks;
    in property <string> host-incoming;
    in property <string> settings-error;
    callback device-name-committed(string);
    callback host-port-committed(string);
    callback host-networks-committed(string);
    callback host-choose-incoming;
    callback open-url(string);

    // Notifications
    in property <string> toast;
    in property <bool> toast-error;

    KSplitView {
        app-title: "Okno";
        items: [
            { title: @tr("Devices"), icon: Icons.devices },
            { title: @tr("This Computer"), icon: Icons.host },
        ];
        current <=> root.page;
        menu: [
            { title: @tr("Preferences"), icon: Icons.settings },
            { title: @tr("About Okno"), icon: Icons.host },
        ];
        menu-activated(i) => {
            if i == 0 { root.settings-open = true; } else { root.about-open = true; }
        }
        content-title: root.page == 0 ? @tr("Devices") : @tr("This Computer");
        actions: root.page == 0 ? [{ icon: Icons.refresh, tooltip: @tr("Search Again") }] : [];
        action(i) => { root.refresh(); }

        if root.page == 0: DevicesPage {
            nearby: root.nearby;
            recent: root.recent;
            searching: root.searching;
            address <=> root.address;
            connect(e) => { root.connect(e); }
            forget(f) => { root.forget(f); }
        }
        if root.page == 1: HostPage {
            running: root.host-running;
            starting: root.host-starting;
            status: root.host-status;
            fingerprint: root.host-fingerprint;
            addresses: root.host-addresses;
            has-login: root.host-has-login;
            login-user: root.host-login-user;
            login-error: root.host-login-error;
            sessions: root.host-sessions;
            discoverable <=> root.host-discoverable;
            new-user <=> root.host-new-user;
            new-password <=> root.host-new-password;
            new-repeat <=> root.host-new-repeat;
            toggle(on) => { root.host-toggle(on); }
            set-login => { root.host-set-login(); }
            disconnect(id) => { root.host-disconnect(id); }
            discoverable-changed(on) => { root.host-discoverable-changed(on); }
        }
    }

    if root.toast != "": KToast {
        text: root.toast;
        error: root.toast-error;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
    }

    if root.settings-open: KSheet {
        title: @tr("Preferences");
        sheet-width: 600px;
        sheet-height: 620px;
        closed => { root.settings-open = false; }
        SettingsContent {
            device-name <=> root.device-name;
            saved-name: root.saved-device-name;
            fingerprint: root.host-fingerprint;
            port <=> root.host-port;
            saved-port: root.host-saved-port;
            networks <=> root.host-networks;
            saved-networks: root.host-saved-networks;
            incoming: root.host-incoming;
            error: root.settings-error;
            device-name-committed(n) => { root.device-name-committed(n); }
            port-committed(p) => { root.host-port-committed(p); }
            networks-committed(n) => { root.host-networks-committed(n); }
            choose-incoming => { root.host-choose-incoming(); }
        }
    }

    // AdwAboutDialog.
    if root.about-open: KSheet {
        title: "";
        sheet-width: 360px;
        sheet-height: 560px;
        closed => { root.about-open = false; }
        KPage {
            VerticalLayout {
                spacing: 6px;
                HorizontalLayout {
                    alignment: center;
                    Image {
                        width: 128px;
                        height: 128px;
                        source: Icons.app;
                    }
                }
                KText {
                    text: "Okno";
                    font-size: 26px;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                KText {
                    text: "Cheviiot";
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    padding-top: 6px;
                    Rectangle {
                        width: ver.preferred-width + 20px;
                        height: 26px;
                        border-radius: 13px;
                        background: Theme.accent.transparentize(80%);
                        ver := KText {
                            text: root.version;
                            color: Theme.accent-text;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            KGroup {
                KRow {
                    title: @tr("Website");
                    activatable: true;
                    clicked => { root.open-url("https://github.com/Cheviiot/Okno"); }
                    KIcon { source: Icons.external; }
                }
                KRow {
                    title: @tr("Report an Issue");
                    activatable: true;
                    last: true;
                    clicked => { root.open-url("https://github.com/Cheviiot/Okno/issues"); }
                    KIcon { source: Icons.external; }
                }
            }
            KGroup {
                KRow {
                    title: @tr("Legal");
                    subtitle: "GPL-3.0-only";
                    activatable: true;
                    last: true;
                    clicked => { root.open-url("https://www.gnu.org/licenses/gpl-3.0.html"); }
                    KIcon { source: Icons.external; }
                }
            }
            KCaption {
                text: @tr("This application comes with absolutely no warranty.");
                horizontal-alignment: center;
            }
        }
    }

    if dialog == DialogKind.connecting: KDialog {
        title: @tr("Connecting…");
        body: root.dialog-host;
        HorizontalLayout { alignment: center; KSpinner { width: 32px; height: 32px; } }
        KDialogButtons {
            KButton { text: @tr("Cancel"); clicked => { root.dialog-cancelled(); } }
        }
    }

    if dialog == DialogKind.trust-new: KDialog {
        title: @tr("New Device");
        body: @tr("You are connecting to “{}” for the first time. Check that this fingerprint matches the one shown on that computer under This Computer → Identity.", root.dialog-host);
        KText {
            text: root.dialog-fingerprint;
            font-family: Theme.mono-family;
            font-size: 16px;
            horizontal-alignment: center;
        }
        KDialogButtons {
            KButton { text: @tr("Cancel"); clicked => { root.dialog-cancelled(); } }
            KButton { text: @tr("Trust"); primary: true; clicked => { root.trust-accepted(); } }
        }
    }

    if dialog == DialogKind.trust-changed: KDialog {
        title: @tr("Device Key Changed");
        warning: true;
        body: @tr("The device at this address now has a different key. This happens after reinstalling Okno — or when someone impersonates the device. Connect only if you know why it changed.");
        KCaption { text: @tr("Was: {}", root.dialog-previous); horizontal-alignment: center; font-family: Theme.mono-family; }
        KCaption { text: @tr("Now: {}", root.dialog-fingerprint); horizontal-alignment: center; font-family: Theme.mono-family; }
        KDialogButtons {
            KButton { text: @tr("Cancel"); clicked => { root.dialog-cancelled(); } }
            KButton { text: @tr("Trust New Key"); destructive: true; clicked => { root.trust-accepted(); } }
        }
    }

    if dialog == DialogKind.login: KDialog {
        title: @tr("Log In to {}", root.dialog-host);
        body: @tr("Enter the login set on that computer.");
        KGroup {
            KEntryRow {
                title: @tr("Username");
                text <=> root.login-user;
                enabled: !root.login-busy;
                first: true;
                accepted => { password.focus(); }
            }
            password := KEntryRow {
                title: @tr("Password");
                password: true;
                text <=> root.login-password;
                enabled: !root.login-busy;
                error: root.login-error != "";
                last: true;
                accepted => { root.login-submitted(); }
                init => { self.focus(); }
            }
        }
        if root.login-error != "": KCaption {
            text: root.login-error;
            color: Theme.destructive-text;
            horizontal-alignment: center;
        }
        KDialogButtons {
            KButton { text: @tr("Cancel"); clicked => { root.dialog-cancelled(); } }
            KButton {
                text: root.login-busy ? @tr("Checking…") : @tr("Connect");
                primary: true;
                enabled: !root.login-busy && root.login-password != "";
                clicked => { root.login-submitted(); }
            }
        }
    }
}

component SessionBar inherits KHeaderBar {
    in property <[string]> displays;
    in-out property <int> display;
    in property <bool> fullscreen;
    callback open-tools;
    in property <bool> sound;
    callback toggle-sound;
    callback display-selected(int);
    callback toggle-fullscreen;
    callback disconnect;

    // No window buttons in full screen; the leave button replaces them.
    start-controls: !fullscreen;
    end-controls: !fullscreen;
    if root.displays.length > 1: ComboBox {
        model: root.displays;
        current-index <=> root.display;
        selected => { root.display-selected(self.current-index); }
    }
    KIconButton {
        icon: root.sound ? Icons.speaker : Icons.speaker-muted;
        tooltip: root.sound ? @tr("Mute Sound") : @tr("Play Sound");
        clicked => { root.toggle-sound(); }
    }
    KIconButton {
        icon: Icons.more;
        tooltip: @tr("Tools");
        clicked => { root.open-tools(); }
    }
    KIconButton {
        icon: root.fullscreen ? Icons.unfullscreen : Icons.fullscreen;
        tooltip: root.fullscreen ? @tr("Leave Full Screen") : @tr("Full Screen");
        clicked => { root.toggle-fullscreen(); }
    }
    KButton {
        text: @tr("Disconnect");
        destructive: true;
        clicked => { root.disconnect(); }
    }
}

// Files sheet of a session: send, transfers, browse the host.
component FilesContent inherits KPage {
    in property <string> host-name;
    in property <string> path;
    in property <bool> can-up;
    in property <bool> loading;
    in property <string> error;
    in property <[FileRow]> files;
    in property <[TransferRow]> transfers;
    callback send;
    callback up;
    callback activate(int);
    callback open-transfer(int);

    KGroup {
        title: @tr("Send to {}", root.host-name);
        description: @tr("Files are saved to the Downloads folder on that computer.");
        KButtonRow {
            title: @tr("Choose Files…");
            primary: true;
            clicked => { root.send(); }
        }
    }

    if root.transfers.length > 0: KGroup {
        title: @tr("Transfers");
        for t[i] in root.transfers: KRow {
            has-icon: true;
            icon: t.upload ? Icons.send : Icons.download;
            title: t.name;
            subtitle: t.status;
            last: i == root.transfers.length - 1;
            activatable: t.state == 1 && !t.upload;
            clicked => { root.open-transfer(i); }
            if t.state == 0: VerticalLayout {
                alignment: center;
                KProgressBar {
                    width: 120px;
                    progress: t.progress;
                }
            }
            if t.state == 1: KIcon { source: Icons.ok; tint: Theme.success; }
            if t.state == 2: KIcon { source: Icons.warning; tint: Theme.destructive-text; }
        }
    }

    KGroup {
        title: @tr("Files on {}", root.host-name);
        description: root.path;
        busy: root.loading;
        if root.can-up: KRow {
            has-icon: true;
            icon: Icons.up;
            title: @tr("Parent Folder");
            activatable: true;
            last: root.files.length == 0 && root.error == "";
            clicked => { root.up(); }
        }
        if root.error != "": KRow {
            title: root.error;
            last: true;
        }
        if root.error == "" && root.files.length == 0 && !root.loading: KRow {
            title: @tr("The folder is empty");
            last: true;
        }
        for f[i] in root.files: KRow {
            has-icon: true;
            icon: f.is-dir ? Icons.folder : Icons.file;
            title: f.name;
            subtitle: f.subtitle;
            activatable: true;
            last: i == root.files.length - 1;
            clicked => { root.activate(i); }
            KIcon { source: f.is-dir ? Icons.go : Icons.download; tint: Theme.dim-fg; }
        }
    }
}

export component SessionWindow inherits KAppWindow {
    in property <string> session-title;
    in property <string> host-name;
    in-out property <bool> files-open;
    in property <string> files-path;
    in property <bool> files-can-up;
    in property <bool> files-loading;
    in property <string> files-error;
    in property <[FileRow]> files;
    in property <[TransferRow]> transfers;
    callback files-opened;
    callback files-send;
    callback files-up;
    callback files-activate(int);
    callback files-open-transfer(int);

    in property <bool> sound-on;
    callback sound-toggled;
    in-out property <bool> tools-open;
    in-out property <bool> ports-open;
    in property <[ForwardRow]> forwards;
    in-out property <string> forward-local;
    in-out property <string> forward-target;
    in property <string> forward-error;
    callback open-terminal;
    callback add-forward;
    callback remove-forward(int);
    in property <image> frame;
    in property <bool> has-frame;
    in property <string> status;
    in property <[string]> displays;
    in-out property <int> display;
    in property <bool> fullscreen;
    callback pointer-moved(float, float);
    callback pointer-button(int, bool);
    callback scrolled(length, length);
    callback display-selected(int);
    callback toggle-fullscreen;
    callback disconnect;

    title: session-title;
    preferred-width: 1280px;
    preferred-height: 800px;
    full-screen: fullscreen;

    // In full screen the header bar hides and slides in when the pointer
    // touches the top edge, as in GNOME Connections.
    property <bool> reveal;

    VerticalLayout {
    if !fullscreen: SessionBar {
        title: root.session-title;
        displays: root.displays;
        display <=> root.display;
        fullscreen: false;
        open-tools => { root.tools-open = !root.tools-open; }
        sound: root.sound-on;
        toggle-sound => { root.sound-toggled(); }
        display-selected(i) => { root.display-selected(i); }
        toggle-fullscreen => { root.toggle-fullscreen(); }
        disconnect => { root.disconnect(); }
    }
    video := Rectangle {
        background: #000000;
        property <float> iw: max(1, root.frame.width);
        property <float> ih: max(1, root.frame.height);
        property <float> scale: min(self.width / 1px / iw, self.height / 1px / ih);
        property <length> dw: iw * scale * 1px;
        property <length> dh: ih * scale * 1px;
        property <length> ox: (self.width - dw) / 2;
        property <length> oy: (self.height - dh) / 2;

        Image {
            x: video.ox;
            y: video.oy;
            width: video.dw;
            height: video.dh;
            source: root.frame;
            image-rendering: smooth;
        }
        if !root.has-frame: VerticalLayout {
            alignment: center;
            spacing: 16px;
            HorizontalLayout { alignment: center; KSpinner { width: 32px; height: 32px; } }
            Text {
                text: root.status;
                color: #ffffffc0;
                horizontal-alignment: center;
                font-size: 15px;
            }
        }
        area := TouchArea {
            mouse-cursor: root.has-frame ? MouseCursor.none : MouseCursor.default;
            changed mouse-x => { root.report(); }
            changed mouse-y => {
                root.report();
                if root.reveal && self.mouse-y > 80px { root.reveal = false; }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.down || e.kind == PointerEventKind.up {
                    root.report();
                    root.pointer-button(
                        e.button == PointerEventButton.left ? 1
                        : e.button == PointerEventButton.right ? 2
                        : e.button == PointerEventButton.middle ? 3
                        : e.button == PointerEventButton.back ? 4
                        : e.button == PointerEventButton.forward ? 5 : 0,
                        e.kind == PointerEventKind.down);
                }
            }
            scroll-event(e) => {
                root.scrolled(e.delta-x, e.delta-y);
                accept
            }
        }
    }
    }

    if root.fullscreen: TouchArea {
        y: 0;
        height: 3px;
        changed has-hover => { if self.has-hover { root.reveal = true; } }
    }
    if root.fullscreen && root.reveal: SessionBar {
        y: 0;
        height: 47px;
        title: root.session-title;
        displays: root.displays;
        display <=> root.display;
        fullscreen: true;
        open-tools => { root.tools-open = !root.tools-open; }
        sound: root.sound-on;
        toggle-sound => { root.sound-toggled(); }
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000060;
        display-selected(i) => { root.display-selected(i); }
        toggle-fullscreen => { root.reveal = false; root.toggle-fullscreen(); }
        disconnect => { root.disconnect(); }
    }

    // Tools menu under the header bar button.
    if root.tools-open: TouchArea {
        clicked => { root.tools-open = false; }
    }
    if root.tools-open: Rectangle {
        x: parent.width - self.width - 200px;
        y: 44px;
        width: 240px;
        height: tools-list.preferred-height;
        background: Theme.popover-bg;
        border-radius: Theme.radius-card;
        border-width: 1px;
        border-color: Theme.dark ? #00000066 : #00000612;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000040;
        tools-list := VerticalLayout {
            padding: 6px;
            for item[i] in [
                { title: @tr("Files"), icon: Icons.folder },
                { title: @tr("Terminal"), icon: Icons.terminal },
                { title: @tr("Port Forwarding"), icon: Icons.ports },
            ]: Rectangle {
                height: 36px;
                border-radius: Theme.radius-control;
                background: tarea.has-hover ? Theme.control : transparent;
                accessible-role: button;
                accessible-label: item.title;
                tarea := TouchArea {
                    clicked => {
                        root.tools-open = false;
                        root.reveal = false;
                        if i == 0 { root.files-open = true; root.files-opened(); }
                        else if i == 1 { root.open-terminal(); }
                        else { root.ports-open = true; }
                    }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 12px;
                    KIcon { source: item.icon; }
                    KText { text: item.title; vertical-alignment: center; }
                }
            }
        }
    }

    if root.ports-open: KSheet {
        title: @tr("Port Forwarding");
        sheet-width: 560px;
        sheet-height: 540px;
        closed => { root.ports-open = false; }
        KPage {
            KGroup {
                title: @tr("New Forward");
                description: @tr("Connections to the local port reach the address as seen from {}.", root.host-name);
                KEntryRow {
                    title: @tr("Local Port");
                    text <=> root.forward-local;
                    first: true;
                }
                KEntryRow {
                    title: @tr("Remote Address, e.g. localhost:5432");
                    text <=> root.forward-target;
                    error: root.forward-error != "";
                    last: true;
                    accepted => { root.add-forward(); }
                }
            }
            HorizontalLayout {
                spacing: 12px;
                KCaption {
                    text: root.forward-error;
                    color: Theme.destructive-text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                KButton {
                    text: @tr("Add");
                    primary: true;
                    enabled: root.forward-target != "";
                    clicked => { root.add-forward(); }
                }
            }
            if root.forwards.length > 0: KGroup {
                title: @tr("Active Forwards");
                for f[i] in root.forwards: KRow {
                    has-icon: true;
                    icon: Icons.ports;
                    title: f.title;
                    subtitle: f.subtitle;
                    mono-subtitle: false;
                    last: i == root.forwards.length - 1;
                    KIconButton {
                        icon: Icons.trash;
                        tooltip: @tr("Remove");
                        clicked => { root.remove-forward(i); }
                    }
                }
            }
        }
    }

    if root.files-open: KSheet {
        title: @tr("Files");
        sheet-width: 640px;
        sheet-height: 640px;
        closed => { root.files-open = false; }
        FilesContent {
            host-name: root.host-name;
            path: root.files-path;
            can-up: root.files-can-up;
            loading: root.files-loading;
            error: root.files-error;
            files: root.files;
            transfers: root.transfers;
            send => { root.files-send(); }
            up => { root.files-up(); }
            activate(i) => { root.files-activate(i); }
            open-transfer(i) => { root.files-open-transfer(i); }
        }
    }

    function report() {
        if root.has-frame && video.dw > 0 && video.dh > 0 {
            root.pointer-moved((area.mouse-x - video.ox) / video.dw, (area.mouse-y - video.oy) / video.dh);
        }
    }
}

// Remote shell, like GNOME Console.
export component TerminalWindow inherits KAppWindow {
    in property <string> term-title;
    in property <[TermRun]> runs;
    in property <int> cursor-row;
    in property <int> cursor-col;
    in property <bool> cursor-visible: true;
    in property <bool> exited;
    in property <string> status;
    callback key(string, bool, bool, bool);
    callback resized(int, int);
    callback scrolled(int);

    title: term-title;
    preferred-width: 860px;
    preferred-height: 540px;
    min-width: 360px;
    min-height: 240px;

    property <color> term-bg: Theme.dark ? #1e1e1e : #ffffff;
    property <length> font-size: 14.67px;

    VerticalLayout {
        KHeaderBar {
            title: root.term-title;
            bg: root.term-bg;
        }
        screen := Rectangle {
            background: root.term-bg;
            clip: true;
            measure := Text {
                visible: false;
                text: "MMMMMMMMMM";
                font-family: Theme.mono-family;
                font-size: root.font-size;
            }
            property <length> cw: measure.preferred-width / 10;
            property <length> ch: measure.preferred-height;
            property <int> cols: max(2, floor((self.width - 20px) / max(1px, cw)));
            property <int> rows: max(2, floor((self.height - 12px) / max(1px, ch)));
            changed cols => { root.resized(self.cols, self.rows); }
            changed rows => { root.resized(self.cols, self.rows); }
            init => { root.resized(self.cols, self.rows); }

            Rectangle {
                x: 10px;
                y: 6px;
                for r in root.runs: Rectangle {
                    x: r.col * screen.cw;
                    y: r.row * screen.ch;
                    width: r.len * screen.cw;
                    height: screen.ch;
                    background: r.has-bg ? r.bg : transparent;
                    Text {
                        x: 0;
                        text: r.text;
                        color: r.default-fg ? Theme.fg : r.fg;
                        font-family: Theme.mono-family;
                        font-size: root.font-size;
                        font-weight: r.bold ? 700 : 400;
                        font-italic: r.italic;
                        vertical-alignment: center;
                    }
                    if r.underline: Rectangle {
                        y: parent.height - 2px;
                        height: 1px;
                        background: r.default-fg ? Theme.fg : r.fg;
                    }
                }
                if root.cursor-visible && !root.exited: Rectangle {
                    x: root.cursor-col * screen.cw;
                    y: root.cursor-row * screen.ch;
                    width: screen.cw;
                    height: screen.ch;
                    background: keys.has-focus ? Theme.fg.transparentize(35%) : transparent;
                    border-width: keys.has-focus ? 0px : 1px;
                    border-color: Theme.fg;
                }
            }
            TouchArea {
                mouse-cursor: MouseCursor.text;
                clicked => { keys.focus(); }
                scroll-event(e) => {
                    root.scrolled(e.delta-y > 0 ? 3 : e.delta-y < 0 ? -3 : 0);
                    accept
                }
            }
            keys := FocusScope {
                init => { self.focus(); }
                key-pressed(e) => {
                    root.key(e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift);
                    accept
                }
            }
            if root.exited: Rectangle {
                y: parent.height - self.height;
                height: 44px;
                background: Theme.accent.transparentize(15%);
                KText {
                    text: root.status;
                    color: Theme.accent-fg;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// Texts built by Rust code, kept here so they are translated with the rest.
export global Messages {
    pure public function invalid-address(a: string) -> string { @tr("“{}” is not a valid address", a) }
    pure public function cannot-resolve(h: string) -> string { @tr("Cannot find “{}” on the network", h) }
    pure public function unreachable(h: string) -> string { @tr("{} does not answer. Is Okno running there with remote control allowed?", h) }
    pure public function timeout() -> string { @tr("The device did not answer in time") }
    pure public function version() -> string { @tr("The device runs an incompatible version of Okno") }
    pure public function refused(r: string) -> string { @tr("The device refused the connection: {}", r) }
    pure public function busy() -> string { @tr("The device is busy, try again in a moment") }
    pure public function not-configured() -> string { @tr("The device has no login set yet") }
    pure public function protocol() -> string { @tr("Unexpected reply from the device") }
    pure public function bad-credentials() -> string { @tr("Wrong username or password") }
    pure public function throttled(s: int) -> string { @tr("Too many attempts. Try again in {} s", s) }
    pure public function network(e: string) -> string { @tr("Connection lost: {}", e) }

    pure public function host-off() -> string { @tr("Others cannot connect to this computer") }
    pure public function host-no-login() -> string { @tr("Set a login below first") }
    pure public function host-permission() -> string { @tr("Waiting for screen sharing permission…") }
    pure public function host-listening(port: int) -> string { @tr("Waiting for connections on port {}", port) }
    pure public function host-sessions(n: int) -> string { @tr("{n} device connected" | "{n} devices connected" % n) }
    pure public function host-denied() -> string { @tr("Screen sharing was not allowed") }
    pure public function host-failed(e: string) -> string { @tr("Could not start: {}", e) }
    pure public function passwords-differ() -> string { @tr("Passwords do not match") }
    pure public function bad-login(e: string) -> string { @tr("Invalid login: {}", e) }
    pure public function login-saved() -> string { @tr("Login saved") }
    pure public function session-from(peer: string, user: string) -> string { @tr("{} as {}", peer, user) }

    pure public function video-waiting() -> string { @tr("Waiting for the picture…") }
    pure public function session-ended() -> string { @tr("The session has ended") }
    pure public function session-closed(r: string) -> string { @tr("The session has ended: {}", r) }
    pure public function display-name(i: int, name: string, w: int, h: int) -> string { @tr("{}: {} ({}×{})", i, name, w, h) }
    pure public function device-subtitle(addr: string, os: string) -> string { @tr("{} · {}", addr, os) }
    pure public function forgotten() -> string { @tr("Device forgotten") }
    pure public function name-saved() -> string { @tr("Device name saved") }
    pure public function connected-title(device: string) -> string { @tr("{} is controlling this computer", device) }
    pure public function connected-body(peer: string, user: string) -> string { @tr("Connected from {} as “{}”. Disconnect it under This Computer if you did not expect this.", peer, user) }
    pure public function bad-networks(e: string) -> string { @tr("Invalid network list: {}", e) }
    pure public function choose-folder() -> string { @tr("Choose a Folder for Received Files") }
    pure public function bad-host-port() -> string { @tr("Enter a port between 1 and 65535") }
    pure public function settings-saved() -> string { @tr("Settings saved") }

    pure public function size(n: string, unit: int) -> string {
        unit == 0 ? @tr("{} B", n) : unit == 1 ? @tr("{} kB", n) : unit == 2 ? @tr("{} MB", n) : @tr("{} GB", n)
    }
    pure public function transfer-progress(done: string, total: string) -> string { @tr("{} of {}", done, total) }
    pure public function transfer-waiting() -> string { @tr("Waiting…") }
    pure public function downloaded() -> string { @tr("Saved to Downloads") }
    pure public function uploaded() -> string { @tr("Sent") }
    pure public function transfer-failed(e: string) -> string { @tr("Failed: {}", e) }
    pure public function choose-files() -> string { @tr("Choose Files to Send") }
    pure public function terminal-title(host: string) -> string { @tr("Terminal — {}", host) }
    pure public function terminal-exited(code: int) -> string { @tr("The shell has ended with code {}", code) }
    pure public function forward-title(port: int, target: string) -> string { @tr("localhost:{} → {}", port, target) }
    pure public function forward-subtitle(host: string) -> string { @tr("through {}", host) }
    pure public function bad-port() -> string { @tr("Enter a port between 1 and 65535, or leave it empty for any free port") }
    pure public function bad-target() -> string { @tr("Enter the address as host:port") }
    pure public function forward-failed(e: string) -> string { @tr("Cannot listen: {}", e) }
}
