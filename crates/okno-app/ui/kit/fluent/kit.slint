// Widget kit that follows Windows 11 Fluent (WinUI 3 colours and metrics).
// Must export the same components and properties as kit/adwaita/kit.slint.

import { Palette, ScrollView, Spinner } from "std-widgets.slint";
import { NavItem, HeaderAction, Icons, WindowOps } from "../../common.slint";

export global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <string> kit: "fluent";
    out property <bool> csd: false;

    out property <color> window-bg: dark ? #202020 : #f3f3f3;
    out property <color> view-bg: dark ? #272727 : #f9f9f9;
    out property <color> card-bg: dark ? #2b2b2b : #fbfbfb;
    out property <color> sidebar-bg: window-bg;
    out property <color> headerbar-bg: window-bg;
    out property <color> dialog-bg: dark ? #2b2b2b : #ffffff;
    out property <color> fg: dark ? #ffffff : #1a1a1a;
    out property <color> dim-fg: dark ? #cfcfcf : #5d5d5d;
    // System accent; set from Rust.
    in-out property <color> accent: dark ? #60cdff : #005fb8;
    out property <color> accent-fg: dark ? #000000 : #ffffff;
    out property <color> accent-text: dark ? #99ebff : #003e92;
    out property <color> destructive: dark ? #ff99a4 : #c42b1c;
    out property <color> destructive-text: destructive;
    out property <color> success: dark ? #6ccb5f : #0f7b0f;
    out property <color> warning: dark ? #fce100 : #9d5d00;
    out property <color> separator: dark ? #ffffff15 : #0000000f;
    out property <color> shade: dark ? #0000004d : #0000000f;
    out property <color> control: dark ? #ffffff0f : #ffffffb3;
    out property <color> control-hover: dark ? #ffffff15 : #f9f9f980;
    out property <color> control-active: dark ? #ffffff08 : #f9f9f94d;
    out property <color> subtle-hover: dark ? #ffffff0f : #0000000a;
    out property <color> subtle-active: dark ? #ffffff0b : #00000006;
    out property <color> stroke: dark ? #ffffff12 : #0000000f;
    out property <color> stroke-bottom: dark ? #ffffff18 : #00000029;

    out property <length> radius-control: 4px;
    out property <length> radius-card: 8px;
    out property <length> font-body: 14px;
    out property <length> font-small: 12px;
    out property <length> font-caption: 12px;
    out property <color> popover-bg: dialog-bg;
    out property <color> border: stroke;
    out property <color> row-hover: control-hover;
    out property <color> row-active: control-active;
    out property <length> font-heading: 14px;
    out property <length> font-title: 28px;
    out property <string> font-family: "Segoe UI Variable Text";
    out property <string> mono-family: "Cascadia Mono";
}

export component KText inherits Text {
    color: Theme.fg;
    font-size: Theme.font-body;
    font-family: Theme.font-family;
}

export component KIcon inherits Rectangle {
    in property <image> source;
    in property <color> tint: Theme.fg;
    in property <length> size: 16px;
    width: size;
    min-height: size;
    Image {
        width: root.size;
        height: root.size;
        y: (parent.height - self.height) / 2;
        source: root.source;
        colorize: root.tint;
    }
}

export component KButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> primary;
    in property <bool> destructive;
    in property <bool> flat;
    in property <bool> pill;
    in property <bool> circular;
    in property <bool> enabled: true;
    callback clicked;

    min-height: 32px;
    min-width: 32px;
    border-radius: Theme.radius-control;
    border-width: (flat || primary || destructive) ? 0px : 1px;
    border-color: Theme.stroke;
    opacity: enabled ? 1 : 0.45;
    background: primary ? (touch.pressed ? Theme.accent.transparentize(20%) : touch.has-hover ? Theme.accent.transparentize(10%) : Theme.accent)
        : destructive ? (touch.pressed ? Theme.destructive.transparentize(20%) : touch.has-hover ? Theme.destructive.transparentize(10%) : Theme.destructive)
        : flat ? (touch.pressed ? Theme.subtle-active : touch.has-hover ? Theme.subtle-hover : transparent)
        : touch.pressed ? Theme.control-active
        : touch.has-hover ? Theme.control-hover
        : Theme.control;
    animate background { duration: 83ms; }

    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { clicked(); }

    // Elevation line under standard buttons.
    if !flat && !primary && !destructive: Rectangle {
        y: parent.height - 1px;
        x: Theme.radius-control;
        width: parent.width - 2 * Theme.radius-control;
        height: 1px;
        background: Theme.stroke-bottom;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: text == "" ? 8px : 12px;
        padding-right: text == "" ? 8px : 12px;
        spacing: 8px;
        alignment: center;
        if has-icon: KIcon {
            source: icon;
            tint: (primary || destructive) ? Theme.accent-fg : Theme.fg;
        }
        if text != "": KText {
            text: root.text;
            vertical-alignment: center;
            color: (primary || destructive) ? Theme.accent-fg : Theme.fg;
        }
    }
}

export component KIconButton inherits KButton {
    in property <string> tooltip;
    has-icon: true;
    flat: true;
    accessible-label: tooltip;
}

export component KEntry inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <bool> error;
    in property <bool> mono;
    callback accepted;
    callback edited;
    forward-focus: input;

    min-height: 32px;
    min-width: 120px;
    border-radius: Theme.radius-control;
    background: input.has-focus ? (Theme.dark ? #1f1f1f : #ffffff) : Theme.control;
    border-width: 1px;
    border-color: Theme.stroke;
    opacity: enabled ? 1 : 0.45;

    // Bottom line: thin grey normally, 2 px accent (or red) when focused.
    Rectangle {
        y: parent.height - self.height;
        x: 1px;
        width: parent.width - 2px;
        height: input.has-focus || error ? 2px : 1px;
        background: error ? Theme.destructive : input.has-focus ? Theme.accent : Theme.stroke-bottom;
    }
    KText {
        x: 11px;
        width: parent.width - 22px;
        height: parent.height;
        visible: root.text == "";
        text: root.placeholder;
        color: Theme.dim-fg;
        vertical-alignment: center;
        overflow: elide;
    }
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        input := TextInput {
            text <=> root.text;
            enabled: root.enabled;
            input-type: password ? InputType.password : InputType.text;
            vertical-alignment: center;
            color: Theme.fg;
            selection-background-color: Theme.accent.transparentize(50%);
            font-size: Theme.font-body;
            font-family: mono ? Theme.mono-family : Theme.font-family;
            single-line: true;
            accessible-role: text-input;
            accessible-placeholder-text: placeholder;
            accepted => { root.accepted(); }
            edited => { root.edited(); }
        }
    }
}

export component KSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    // The root fills the layout cell; the visible track is centred in it.
    width: 40px;
    min-height: 20px;
    opacity: enabled ? 1 : 0.45;
    accessible-role: switch;
    accessible-checked: checked;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 20px;
        border-radius: 10px;
        background: root.checked ? Theme.accent : (touch.has-hover ? Theme.subtle-hover : transparent);
        border-width: root.checked ? 0px : 1px;
        border-color: Theme.dim-fg;
        Rectangle {
            property <length> size: touch.has-hover ? 14px : 12px;
            width: size;
            height: size;
            y: (parent.height - self.height) / 2;
            x: root.checked ? parent.width - self.width - 4px : 4px;
            border-radius: self.width / 2;
            background: root.checked ? Theme.accent-fg : Theme.dim-fg;
            animate x, width, height { duration: 167ms; easing: ease-out; }
        }
    }
}

// A settings section: a heading and a stack of setting cards.
export component KGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <bool> busy;
    spacing: 4px;

    if title != "": VerticalLayout {
        spacing: 2px;
        padding-bottom: 4px;
        KText {
            text: title;
            font-weight: 600;
            font-size: Theme.font-heading;
        }
        if description != "": KText {
            text: description;
            color: Theme.dim-fg;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        spacing: 3px;
        @children
    }
}

// One settings card; children go to the end (suffix widgets).
export component KRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> activatable;
    in property <bool> last;
    in property <bool> mono-subtitle;
    callback clicked;

    min-height: subtitle == "" ? 52px : 64px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.stroke;
    background: activatable && touch.pressed ? Theme.control-active : activatable && touch.has-hover ? Theme.control-hover : Theme.card-bg;
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { clicked(); }

    touch := TouchArea {
        enabled: root.activatable;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        if has-icon: KIcon {
            size: 20px;
            source: icon;
        }
        if title != "" || subtitle != "": VerticalLayout {
            alignment: center;
            spacing: 1px;
            horizontal-stretch: 1;
            KText {
                text: title;
                overflow: elide;
            }
            if subtitle != "": KText {
                text: subtitle;
                color: Theme.dim-fg;
                font-size: Theme.font-small;
                font-family: mono-subtitle ? Theme.mono-family : Theme.font-family;
                overflow: elide;
            }
        }
        HorizontalLayout {
            alignment: title == "" && subtitle == "" ? LayoutAlignment.stretch : LayoutAlignment.end;
            horizontal-stretch: title == "" && subtitle == "" ? 1 : 0;
            spacing: 8px;
            @children
        }
    }
}

// Scrolling content area.
export component KPage inherits ScrollView {
    VerticalLayout {
        padding-top: 8px;
        padding-bottom: 28px;
        padding-left: 40px;
        padding-right: max(40px, root.width - 1000px - 40px);
        spacing: 28px;
        alignment: start;
        @children
    }
}

// TextBox inside a settings card (WinUI SettingsCard with a TextBox).
export component KEntryRow inherits Rectangle {
    in property <string> title;
    in-out property <string> text;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <bool> error;
    in property <bool> first;
    in property <bool> last;
    in property <bool> show-apply;
    in property <bool> mono;
    callback accepted;
    callback applied;
    callback edited;
    forward-focus: entry;

    min-height: 64px;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.stroke;
    background: Theme.card-bg;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        KText {
            text: root.title;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            entry := KEntry {
                width: 260px;
                text <=> root.text;
                password: root.password;
                enabled: root.enabled;
                error: root.error;
                mono: root.mono;
                accepted => { root.accepted(); }
                edited => { root.edited(); }
            }
        }
        if root.show-apply: VerticalLayout {
            alignment: center;
            KButton {
                text: @tr("Apply");
                primary: true;
                clicked => { root.applied(); }
            }
        }
    }
}

export component KSwitchRow inherits KRow {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);
    KSwitch {
        checked <=> root.checked;
        enabled: root.enabled;
        toggled(on) => { root.toggled(on); }
    }
}

export component KButtonRow inherits Rectangle {
    in property <string> title;
    in property <bool> primary;
    in property <bool> destructive;
    in property <bool> enabled: true;
    in property <bool> last: true;
    callback clicked;
    min-height: 44px;
    HorizontalLayout {
        alignment: end;
        KButton {
            text: root.title;
            primary: root.primary;
            destructive: root.destructive;
            enabled: root.enabled;
            clicked => { root.clicked(); }
        }
    }
}

export component KStatusPage inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> description;
    in property <bool> compact;
    alignment: center;
    spacing: 8px;
    padding-top: 32px;
    padding-bottom: 32px;
    HorizontalLayout {
        alignment: center;
        padding-bottom: 8px;
        KIcon {
            source: root.icon;
            size: root.compact ? 48px : 96px;
            tint: Theme.dim-fg;
        }
    }
    KText {
        text: root.title;
        font-size: 20px;
        font-weight: 600;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if root.description != "": KText {
        text: root.description;
        color: Theme.dim-fg;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    @children
}

// Windows keeps the native title bar.
export component KAppWindow inherits Window {
    background: Theme.window-bg;
    default-font-family: Theme.font-family;
    default-font-size: Theme.font-body;
    @children
}

// Command bar with a title and end actions.
export component KHeaderBar inherits Rectangle {
    in property <string> title;
    in property <bool> start-controls;
    in property <bool> end-controls;
    in property <color> bg: Theme.window-bg;
    in property <bool> border;
    in property <length> title-margin;
    height: 48px;
    background: bg;
    HorizontalLayout {
        padding: 8px;
        padding-left: 16px;
        spacing: 8px;
        KText {
            text: root.title;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        @children
    }
}

component NavButton inherits Rectangle {
    in property <string> title;
    in property <image> icon;
    in property <bool> selected;
    callback clicked;
    height: 36px;
    border-radius: Theme.radius-control;
    background: selected ? Theme.subtle-hover : area.pressed ? Theme.subtle-active : area.has-hover ? Theme.subtle-hover : transparent;
    accessible-role: tab;
    accessible-label: title;
    accessible-item-selected: selected;
    accessible-action-default => { clicked(); }
    area := TouchArea { clicked => { root.clicked(); } }
    if root.selected: Rectangle {
        x: 0;
        width: 3px;
        height: 16px;
        y: (parent.height - self.height) / 2;
        border-radius: 1.5px;
        background: Theme.accent;
    }
    HorizontalLayout {
        padding-left: 16px;
        spacing: 16px;
        KIcon { source: root.icon; }
        KText {
            text: root.title;
            vertical-alignment: center;
        }
    }
}

// NavigationView: pane on the left (items at the top, menu entries such as
// Settings at the bottom) and the content with a large title.
export component KSplitView inherits Rectangle {
    in property <[NavItem]> items;
    in-out property <int> current;
    in property <string> app-title;
    in property <[NavItem]> menu;
    callback menu-activated(int);
    in property <string> content-title;
    in property <[HeaderAction]> actions;
    callback action(int);

    HorizontalLayout {
        Rectangle {
            width: 260px;
            VerticalLayout {
                padding-left: 4px;
                padding-right: 4px;
                padding-bottom: 4px;
                spacing: 4px;
                Rectangle {
                    height: 48px;
                    KText {
                        x: 16px;
                        text: root.app-title;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                }
                for item[i] in root.items: NavButton {
                    title: item.title;
                    icon: item.icon;
                    selected: i == root.current;
                    clicked => { root.current = i; }
                }
                Rectangle { vertical-stretch: 1; }
                for m[i] in root.menu: NavButton {
                    title: m.title;
                    icon: m.icon;
                    clicked => { root.menu-activated(i); }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.view-bg;
            border-top-left-radius: 8px;
            border-width: 1px;
            border-color: Theme.stroke;
            VerticalLayout {
                HorizontalLayout {
                    padding-left: 40px;
                    padding-right: 40px;
                    padding-top: 28px;
                    padding-bottom: 20px;
                    spacing: 8px;
                    KText {
                        text: root.content-title;
                        font-size: Theme.font-title;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    for a[i] in root.actions: KIconButton {
                        icon: a.icon;
                        tooltip: a.tooltip;
                        clicked => { root.action(i); }
                    }
                }
                @children
            }
        }
    }
}

// ContentDialog with a close button, for settings and about.
export component KSheet inherits Rectangle {
    in property <string> title;
    in property <length> sheet-width: 560px;
    in property <length> sheet-height: 540px;
    callback closed;

    background: #0000004d;
    TouchArea { clicked => { root.closed(); } }
    Rectangle {
        width: min(root.sheet-width, parent.width - 24px);
        height: min(root.sheet-height, parent.height - 24px);
        border-radius: Theme.radius-card;
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.stroke;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000047;
        drop-shadow-offset-y: 8px;
        clip: true;
        TouchArea { }
        VerticalLayout {
            HorizontalLayout {
                padding: 8px;
                padding-left: 24px;
                KText {
                    text: root.title;
                    font-size: 20px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                KIconButton {
                    icon: Icons.close;
                    tooltip: @tr("Close");
                    clicked => { root.closed(); }
                }
            }
            @children
        }
    }
}

// Modal dialog over the whole window (WinUI ContentDialog).
export component KDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <bool> warning;

    background: Theme.dark ? #0000004d : #0000004d;
    TouchArea { }

    Rectangle {
        width: min(448px, parent.width - 24px);
        height: content.preferred-height;
        border-radius: Theme.radius-card;
        background: Theme.dialog-bg;
        border-width: 1px;
        border-color: Theme.stroke;
        drop-shadow-blur: 32px;
        drop-shadow-color: #00000047;
        drop-shadow-offset-y: 8px;
        content := VerticalLayout {
            padding: 24px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 12px;
                if warning: KIcon {
                    size: 20px;
                    source: @image-url("../../icons/warning.svg");
                    tint: Theme.warning;
                }
                KText {
                    text: title;
                    font-size: 20px;
                    font-weight: 600;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
            if body != "": KText {
                text: body;
                wrap: word-wrap;
            }
            @children
        }
    }
}

export component KDialogButtons inherits HorizontalLayout {
    spacing: 8px;
    padding-top: 12px;
    alignment: stretch;
    @children
}

export component KToast inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    height: 48px;
    width: min(label.preferred-width + 48px, 560px);
    border-radius: Theme.radius-control;
    background: error ? (Theme.dark ? #442726 : #fde7e9) : Theme.dialog-bg;
    border-width: 1px;
    border-color: Theme.stroke;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000030;
    drop-shadow-offset-y: 4px;
    label := KText {
        text: root.text;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component KSpinner inherits Spinner {
    indeterminate: true;
    width: 16px;
    height: 16px;
}

export component KCaption inherits KText {
    color: Theme.dim-fg;
    font-size: Theme.font-small;
    wrap: word-wrap;
}

// Determinate progress bar (0..1).
export component KProgressBar inherits Rectangle {
    in property <float> progress;
    in property <bool> error;
    height: 3px;
    border-radius: 1.5px;
    background: Theme.control;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.progress, 0, 1);
        border-radius: 1.5px;
        background: root.error ? Theme.destructive : Theme.accent;
        animate width { duration: 150ms; }
    }
}
