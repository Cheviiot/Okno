// Widget kit that follows GNOME's libadwaita (colours and metrics of
// libadwaita 1.6). Must export the same components and properties as
// kit/fluent/kit.slint.

import { Palette, ScrollView, Spinner } from "std-widgets.slint";
import { NavItem, HeaderAction } from "../../common.slint";

export global Theme {
    in-out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <string> kit: "adwaita";

    out property <color> window-bg: dark ? #222226 : #fafafb;
    out property <color> view-bg: dark ? #1d1d20 : #ffffff;
    out property <color> card-bg: dark ? #36363a : #ffffff;
    out property <color> sidebar-bg: dark ? #2e2e32 : #ebebed;
    out property <color> headerbar-bg: dark ? #2e2e32 : #ffffff;
    out property <color> dialog-bg: dark ? #36363a : #ffffff;
    out property <color> fg: dark ? #ffffff : #1e1e20;
    out property <color> dim-fg: dark ? #ffffffa0 : #1e1e208c;
    out property <color> accent: #3584e4;
    out property <color> accent-fg: #ffffff;
    out property <color> accent-text: dark ? #78aeed : #1c71d8;
    out property <color> destructive: dark ? #c01c28 : #e01b24;
    out property <color> destructive-text: dark ? #ff7b63 : #c30000;
    out property <color> success: dark ? #26a269 : #2ec27e;
    out property <color> warning: dark ? #cd9309 : #e5a50a;
    out property <color> separator: dark ? #ffffff1a : #0000061a;
    out property <color> shade: dark ? #00000036 : #00000612;
    out property <color> control: dark ? #ffffff1a : #0000060f;
    out property <color> control-hover: dark ? #ffffff26 : #0000061a;
    out property <color> control-active: dark ? #ffffff40 : #0000062e;

    out property <length> radius-control: 6px;
    out property <length> radius-card: 12px;
    out property <length> font-body: 14.5px;
    out property <length> font-small: 12.5px;
    out property <length> font-heading: 14.5px;
    out property <length> font-title: 26px;
    out property <string> font-family: "Adwaita Sans";
    out property <string> mono-family: "Adwaita Mono";
}

export component KText inherits Text {
    color: Theme.fg;
    font-size: Theme.font-body;
    font-family: Theme.font-family;
}

export component KIcon inherits Rectangle {
    in property <image> source;
    in property <color> tint: Theme.fg;
    in property <length> size: 16px;
    width: size;
    min-height: size;
    Image {
        width: root.size;
        height: root.size;
        y: (parent.height - self.height) / 2;
        source: root.source;
        colorize: root.tint;
    }
}

export component KButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> primary;
    in property <bool> destructive;
    in property <bool> flat;
    in property <bool> enabled: true;
    callback clicked;

    min-height: 34px;
    min-width: 34px;
    border-radius: Theme.radius-control;
    opacity: enabled ? 1 : 0.5;
    background: primary ? (touch.pressed ? Theme.accent.darker(20%) : touch.has-hover ? Theme.accent.brighter(8%) : Theme.accent)
        : destructive ? (touch.pressed ? Theme.destructive.darker(20%) : touch.has-hover ? Theme.destructive.brighter(8%) : Theme.destructive)
        : touch.pressed ? Theme.control-active
        : touch.has-hover ? Theme.control-hover
        : flat ? transparent : Theme.control;
    animate background { duration: 100ms; }

    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: text == "" ? 9px : 17px;
        padding-right: text == "" ? 9px : 17px;
        spacing: 8px;
        alignment: center;
        if has-icon: KIcon {
            source: icon;
            tint: (primary || destructive) ? Theme.accent-fg : Theme.fg;
        }
        if text != "": KText {
            text: root.text;
            vertical-alignment: center;
            font-weight: 700;
            color: (primary || destructive) ? Theme.accent-fg : Theme.fg;
        }
    }
}

export component KIconButton inherits KButton {
    in property <string> tooltip;
    has-icon: true;
    flat: true;
    accessible-label: tooltip;
}

export component KEntry inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password;
    in property <bool> enabled: true;
    in property <bool> error;
    in property <bool> mono;
    callback accepted;
    callback edited;
    forward-focus: input;

    min-height: 34px;
    min-width: 120px;
    border-radius: Theme.radius-control;
    background: error ? Theme.destructive.transparentize(80%) : Theme.control;
    border-width: input.has-focus ? 2px : 0px;
    border-color: error ? Theme.destructive : Theme.accent.transparentize(40%);
    opacity: enabled ? 1 : 0.5;

    KText {
        x: 9px;
        width: parent.width - 18px;
        height: parent.height;
        visible: root.text == "";
        text: root.placeholder;
        color: Theme.dim-fg;
        vertical-alignment: center;
        overflow: elide;
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        input := TextInput {
            text <=> root.text;
            enabled: root.enabled;
            input-type: password ? InputType.password : InputType.text;
            vertical-alignment: center;
            color: Theme.fg;
            selection-background-color: Theme.accent.transparentize(60%);
            font-size: Theme.font-body;
            font-family: mono ? Theme.mono-family : Theme.font-family;
            single-line: true;
            accessible-role: text-input;
            accessible-placeholder-text: placeholder;
            accepted => { root.accepted(); }
            edited => { root.edited(); }
        }
    }
}

export component KSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    // The root fills the layout cell; the visible track is centred in it.
    width: 48px;
    min-height: 26px;
    opacity: enabled ? 1 : 0.5;
    accessible-role: switch;
    accessible-checked: checked;
    accessible-action-default => { touch.clicked(); }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 26px;
        border-radius: 13px;
        background: root.checked ? Theme.accent : (touch.has-hover ? Theme.control-active : Theme.control-hover);
        animate background { duration: 150ms; }
        Rectangle {
            width: 20px;
            height: 20px;
            y: 3px;
            x: root.checked ? parent.width - self.width - 3px : 3px;
            border-radius: 10px;
            background: #ffffff;
            drop-shadow-blur: 2px;
            drop-shadow-color: #00000040;
            drop-shadow-offset-y: 1px;
            animate x { duration: 150ms; easing: ease-out; }
        }
    }
}

// A preferences group: a heading and a boxed list of rows.
export component KGroup inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 8px;

    if title != "": VerticalLayout {
        spacing: 2px;
        padding-left: 2px;
        KText {
            text: title;
            font-weight: 700;
            font-size: Theme.font-heading;
        }
        if description != "": KText {
            text: description;
            color: Theme.dim-fg;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }
    }
    Rectangle {
        background: Theme.card-bg;
        border-radius: Theme.radius-card;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.shade;
        border-width: Theme.dark ? 0px : 1px;
        border-color: Theme.shade;
        clip: true;
        VerticalLayout {
            @children
        }
    }
}

// One row of a boxed list; children go to the end (suffix widgets).
export component KRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <image> icon;
    in property <bool> has-icon;
    in property <bool> activatable;
    in property <bool> last;
    in property <bool> mono-subtitle;
    callback clicked;

    min-height: subtitle == "" ? 50px : 58px;
    background: activatable && touch.pressed ? Theme.control-active : activatable && touch.has-hover ? Theme.control : transparent;
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { clicked(); }

    touch := TouchArea {
        enabled: root.activatable;
        mouse-cursor: root.activatable ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 8px;
        padding-bottom: 8px;
        spacing: 12px;
        if has-icon: KIcon {
            source: icon;
        }
        if title != "" || subtitle != "": VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            KText {
                text: title;
                overflow: elide;
            }
            if subtitle != "": KText {
                text: subtitle;
                color: Theme.dim-fg;
                font-size: Theme.font-small;
                font-family: mono-subtitle ? Theme.mono-family : Theme.font-family;
                overflow: elide;
            }
        }
        HorizontalLayout {
            alignment: title == "" && subtitle == "" ? LayoutAlignment.stretch : LayoutAlignment.end;
            horizontal-stretch: title == "" && subtitle == "" ? 1 : 0;
            spacing: 6px;
            @children
        }
    }

    if !last: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.separator;
    }
}

// A scrolling page with a header bar; content is centred at up to 640 px.
export component KPage inherits Rectangle {
    in property <string> title;
    in property <[HeaderAction]> actions;
    callback action(int);

    background: Theme.window-bg;

    VerticalLayout {
        Rectangle {
            height: 47px;
            background: Theme.headerbar-bg;
            KText {
                text: root.title;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            HorizontalLayout {
                alignment: end;
                padding: 6px;
                spacing: 6px;
                for a[i] in actions: KIconButton {
                    icon: a.icon;
                    tooltip: a.tooltip;
                    clicked => { root.action(i); }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.shade;
            }
        }
        ScrollView {
            VerticalLayout {
                padding-top: 24px;
                padding-bottom: 24px;
                padding-left: max(12px, (parent.width - 640px) / 2);
                padding-right: max(12px, (parent.width - 640px) / 2);
                spacing: 24px;
                alignment: start;
                @children
            }
        }
    }
}

export component KSidebar inherits Rectangle {
    in property <[NavItem]> items;
    in-out property <int> current;
    in property <string> app-title;

    width: 220px;
    background: Theme.sidebar-bg;

    VerticalLayout {
        Rectangle {
            height: 47px;
            KText {
                text: app-title;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            padding: 6px;
            spacing: 2px;
            alignment: start;
            for item[i] in items: Rectangle {
                height: 38px;
                border-radius: Theme.radius-control;
                background: i == current ? Theme.control-hover : area.has-hover ? Theme.control : transparent;
                accessible-role: tab;
                accessible-label: item.title;
                accessible-item-selected: i == current;
                accessible-action-default => { root.current = i; }
                area := TouchArea {
                    clicked => { root.current = i; }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    spacing: 12px;
                    KIcon {
                        source: item.icon;
                    }
                    KText {
                        text: item.title;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// Modal dialog over the whole window; place it last in the window.
export component KDialog inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <bool> warning;

    background: #00000060;
    TouchArea { }  // swallow clicks behind the dialog

    Rectangle {
        width: min(400px, parent.width - 24px);
        height: content.preferred-height;
        border-radius: 18px;
        background: Theme.dialog-bg;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000050;
        drop-shadow-offset-y: 4px;
        content := VerticalLayout {
            padding: 24px;
            padding-top: 28px;
            spacing: 16px;
            if warning: KIcon {
                size: 32px;
                source: @image-url("../../icons/warning.svg");
                tint: Theme.warning;
                x: (parent.width - self.width) / 2;
            }
            KText {
                text: title;
                font-size: 20px;
                font-weight: 800;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if body != "": KText {
                text: body;
                color: Theme.dim-fg;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            @children
        }
    }
}

// Buttons at the bottom of a dialog.
export component KDialogButtons inherits HorizontalLayout {
    spacing: 12px;
    padding-top: 8px;
    alignment: stretch;
    @children
}

export component KToast inherits Rectangle {
    in property <string> text;
    in property <bool> error;
    height: 44px;
    width: min(label.preferred-width + 48px, 560px);
    border-radius: 22px;
    background: error ? Theme.destructive : #333338f0;
    drop-shadow-blur: 8px;
    drop-shadow-color: #00000040;
    label := KText {
        text: root.text;
        color: #ffffff;
        overflow: elide;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component KSpinner inherits Spinner {
    indeterminate: true;
    width: 24px;
    height: 24px;
}

// Label for secondary text in pages.
export component KCaption inherits KText {
    color: Theme.dim-fg;
    font-size: Theme.font-small;
    wrap: word-wrap;
}
